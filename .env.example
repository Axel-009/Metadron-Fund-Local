# Metadron Capital — Environment Variables
# Copy to .env and fill in your values

# === EXTERNAL APIs ===

# --- OpenBB / FMP (Market Data — sole data provider) ---
FMP_API_KEY=your_fmp_api_key_here
OPENBB_TOKEN=your_openbb_token_here

# --- Charles Schwab (SOLE data + execution broker: equities, ETFs, 1–7 DTE options) ---
# Auth modes: oauth (App Key/Secret + refresh token, autonomous refresh),
#             token (paste a short-lived access token — expires ~30 min),
#             proxy (sandbox: credentials injected by an HTTPS proxy, e.g. Ngrok/Perplexity vault)
SCHWAB_AUTH_MODE=oauth
SCHWAB_APP_KEY=your_schwab_app_key
SCHWAB_APP_SECRET=your_schwab_app_secret
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182/callback
SCHWAB_TOKEN_PATH=data/schwab_token.json
# SCHWAB_ACCESS_TOKEN=            # only for SCHWAB_AUTH_MODE=token
# SCHWAB_LIVE_ORDERS=false        # false = DRY_RUN: every order is risk-gated + logged, nothing is sent
# SCHWAB_ACCOUNT_NUMBER=          # single-account mode (last 4 digits ok). Ignored when mandates below are set.
#
# Multi-account mandates (SchwabAccountRouter). Set the last-4 of each account:
#   ROTH        → 25% options / 75% equities+ETFs
#   LLC         → 100% equities + ETFs (no options)
#   INDIVIDUAL  → 100% options (1–7 DTE)
# 20% drawdown on any account or the portfolio → adds blocked, rotate-or-close plan emitted.
# SCHWAB_ACCOUNT_ROTH=
# SCHWAB_ACCOUNT_LLC=
# SCHWAB_ACCOUNT_INDIVIDUAL=
# SCHWAB_ACCOUNT_MANDATES=        # optional JSON override: {"ROTH":{"account_last4":"1234","options_pct":0.25,...}}

# --- Xiaomi Mimo V2 Pro (Brain Power — LLM / Intelligence) ---
XIAOMI_MIMO_API_KEY=your_xiaomi_mimo_v2_pro_api_key_here

# === Infrastructure (internal — not external APIs) ===

# Database (used by engine/db/database.py)
METADRON_DATABASE_URL=sqlite:///data/metadron.db

# Redis (optional — for caching)
# REDIS_URL=redis://localhost:6379/0

# Engine API
ENGINE_API_PORT=8001
ENGINE_API_HOST=0.0.0.0

# LLM Bridge
LLM_BRIDGE_PORT=8002
LLM_BRIDGE_HOST=0.0.0.0

# Frontend / Express
FRONTEND_PORT=5000

# === ZEP — Miro Fish / Agent Simulation (internal memory layer) ===
ZEP_API_URL=http://localhost:8003
ZEP_API_KEY=your_zep_api_key_here
ZEP_COLLECTION=metadron_agents

# === Monitoring ===
GRAFANA_ADMIN_PASSWORD=metadron_secure_password
PROMETHEUS_RETENTION=30d
